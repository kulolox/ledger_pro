{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "@wot-ui/ui/components/wd-$1/wd-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "LedgerPro",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/login/index",
      "style": {
        "navigationBarTitleText": "登录",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/register/index",
      "style": {
        "navigationBarTitleText": "注册",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/forgot-password/index",
      "style": {
        "navigationBarTitleText": "找回密码",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/statistics/index",
      "style": {
        "navigationBarTitleText": "统计",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/category/index",
      "style": {
        "navigationBarTitleText": "分类管理",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/import-export/index",
      "style": {
        "navigationBarTitleText": "导入导出",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/search/index",
      "style": {
        "navigationBarTitleText": "搜索",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/profile/index",
      "style": {
        "navigationBarTitleText": "个人中心",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/change-password/index",
      "style": {
        "navigationBarTitleText": "修改密码",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/update/index",
      "style": {
        "navigationBarTitleText": "检查更新",
        "navigationStyle": "custom"
      }
    }
  ],
  "globalStyle": {
    "pageOrientation": "portrait",
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "LedgerPro",
    "navigationBarBackgroundColor": "#F2F2F7",
    "backgroundColor": "#F2F2F7"
  }
}
